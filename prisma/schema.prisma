generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas    = ["public"]
}

enum Role {
  USER
  ADMIN
  SUPERADMIN

  @@schema("public")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  PENDING_REVIEW

  @@schema("public")
}

enum CommissionStatus {
  PENDING
  APPROVED
  CANCELLED
  PAID

  @@schema("public")
}

model User {
  id            String      @id @default(uuid())
  name          String?
  email         String      @unique
  passwordHash  String?
  image         String?
  role          Role        @default(USER)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  favorites     Favorite[]
  clicks        Click[]
  auditLogs     AuditLog[]

  @@map("users")
  @@schema("public")
}

model AdminUser {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  auditLogs    AuditLog[]

  @@map("admin_users")
  @@schema("public")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?    @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
  @@schema("public")
}

model Supplier {
  id          String    @id @default(uuid())
  name        String
  website     String?
  contact     String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("suppliers")
  @@schema("public")
}

model Marketplace {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  logoUrl         String?            @map("logo_url")
  apiStatus       String             @default("ACTIVE") @map("api_status")
  affiliateStatus String             @default("ACTIVE") @map("affiliate_status")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  products        Product[]
  affiliateLinks  AffiliateLink[]
  conversions     Conversion[]
  affiliatePrograms AffiliateProgram[]

  @@map("marketplaces")
  @@schema("public")
}

model AffiliateProgram {
  id              String      @id @default(uuid())
  marketplaceId   String      @map("marketplace_id")
  name            String
  commissionRate  Decimal     @map("commission_rate") @db.Decimal(8, 4)
  cookieDuration  Int         @default(30) @map("cookie_duration") // dias
  termsUrl        String?     @map("terms_url")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  marketplace     Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@map("affiliate_programs")
  @@schema("public")
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  description          String
  categoryId           String        @map("category_id")
  supplierId           String?       @map("supplier_id")
  marketplaceId        String        @map("marketplace_id")
  productType          String?       @map("product_type")
  brand                String?
  imageUrl             String        @map("image_url")
  images               String        @default("[]") // JSON String array
  videoUrl             String?       @map("video_url")
  price                Decimal       @db.Decimal(14, 2)
  cost                 Decimal?      @db.Decimal(14, 2)
  platformFees         Decimal?      @map("platform_fees") @db.Decimal(14, 2)
  shippingCost         Decimal?      @map("shipping_cost") @db.Decimal(14, 2)
  marketingCost        Decimal?      @map("marketing_cost") @db.Decimal(14, 2)
  otherCosts           Decimal?      @map("other_costs") @db.Decimal(14, 2)
  oldPrice             Decimal?      @map("old_price") @db.Decimal(14, 2)
  discountPercentage   Float?        @map("discount_percentage")
  rating               Float         @default(0)
  reviewCount          Int           @default(0) @map("review_count")
  salesCount           Int           @default(0) @map("sales_count")
  popularityScore      Float         @default(0) @map("popularity_score")
  trendScore           Float         @default(0) @map("trend_score")
  commissionPercentage Decimal       @map("commission_percentage") @db.Decimal(8, 4)
  commissionValue      Decimal       @map("commission_value") @db.Decimal(14, 2)
  externalProductId    String        @map("external_product_id")
  originalUrl          String        @map("original_url")
  affiliateUrl         String        @map("affiliate_url")
  supplierInfo         String?       @map("supplier_info")
  targetAudience       String?       @map("target_audience")
  keyBenefits          String?       @map("key_benefits")
  keyObjections        String?       @map("key_objections")
  competitionNotes     String?       @map("competition_notes")
  deliveryTime         String?       @map("delivery_time")
  returnPolicy         String?       @map("return_policy")
  isBestSeller         Boolean       @default(false) @map("is_best_seller")
  isTrending           Boolean       @default(false) @map("is_trending")
  status               ProductStatus @default(ACTIVE)
  lastSyncedAt         DateTime      @default(now()) @map("last_synced_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category             Category      @relation(fields: [categoryId], references: [id])
  supplier             Supplier?     @relation(fields: [supplierId], references: [id])
  marketplace          Marketplace   @relation(fields: [marketplaceId], references: [id])
  
  affiliateLinks       AffiliateLink[]
  clicks               Click[]
  conversions          Conversion[]
  favorites            Favorite[]
  metrics              ProductMetric?
  priceHistories       PriceHistory[]

  @@map("products")
  @@schema("public")
  @@unique([marketplaceId, externalProductId], map: "products_marketplace_external_unique")
}

model AffiliateLink {
  id            String      @id @default(uuid())
  productId     String      @map("product_id")
  marketplaceId String      @map("marketplace_id")
  url           String
  trackingId    String      @map("tracking_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  clicks        Click[]

  @@map("affiliate_links")
  @@schema("public")
}

model Click {
  id              String         @id @default(uuid())
  productId       String         @map("product_id")
  affiliateLinkId String?        @map("affiliate_link_id")
  sessionId       String?        @map("session_id")
  userId          String?        @map("user_id")
  utmSource       String?        @map("utm_source")
  utmMedium       String?        @map("utm_medium")
  utmCampaign     String?        @map("utm_campaign")
  device          String?
  ipHash          String?        @map("ip_hash")
  createdAt       DateTime       @default(now()) @map("created_at")

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  conversions     Conversion[]

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([sessionId])
  @@map("clicks")
  @@schema("public")
}

model Conversion {
  id               String       @id @default(uuid())
  clickId          String?      @map("click_id")
  productId        String       @map("product_id")
  marketplaceId    String       @map("marketplace_id")
  orderExternalId  String?      @map("order_external_id")
  saleValue        Decimal      @map("sale_value") @db.Decimal(14, 2)
  commissionValue  Decimal      @map("commission_value") @db.Decimal(14, 2)
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at")

  click            Click?       @relation(fields: [clickId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  marketplace      Marketplace  @relation(fields: [marketplaceId], references: [id])
  commission       Commission?

  @@unique([marketplaceId, orderExternalId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([clickId])
  @@map("conversions")
  @@schema("public")
}

model Commission {
  id              String           @id @default(uuid())
  conversionId    String           @unique @map("conversion_id")
  amount          Decimal          @db.Decimal(14, 2)
  status          CommissionStatus @default(PENDING)
  payoutDate      DateTime?        @map("payout_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  conversion      Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@map("commissions")
  @@schema("public")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
  @@schema("public")
}

model ProductMetric {
  id              String   @id @default(uuid())
  productId       String   @unique @map("product_id")
  totalClicks     Int      @default(0) @map("total_clicks")
  totalConversions Int     @default(0) @map("total_conversions")
  conversionRate  Float    @default(0) @map("conversion_rate")
  ctr             Float    @default(0)
  totalCommission Decimal  @default(0) @map("total_commission") @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_metrics")
  @@schema("public")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  price     Decimal  @db.Decimal(14, 2)
  oldPrice  Decimal? @map("old_price") @db.Decimal(14, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
  @@schema("public")
}

model AutomationRun {
  id          String   @id @default(uuid())
  workflow    String
  status      String
  summary     String?  @db.Text
  error       String?  @db.Text
  startedAt   DateTime @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationMs  Int?     @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workflow, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("automation_runs")
  @@schema("public")
}

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?    @map("admin_user_id")
  userId      String?    @map("user_id")
  action      String
  entity      String
  entityId    String?    @map("entity_id")
  details     String?
  createdAt   DateTime   @default(now()) @map("created_at")

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("public")
}
