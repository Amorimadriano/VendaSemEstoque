generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model Partner {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  storeName             String    @map("store_name")
  legalName             String    @map("legal_name")
  document              String
  phone                 String
  businessAddress       String    @map("business_address")
  status                String    @default("PENDING")
  reviewNote            String?   @map("review_note")
  termsVersion          String    @map("terms_version")
  termsAcceptedAt       DateTime  @default(now()) @map("terms_accepted_at") @db.Timestamptz(6)
  acceptedCommissionBps Int?      @map("accepted_commission_bps")
  commissionAcceptedAt  DateTime? @map("commission_accepted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  paymentAccount        PartnerPaymentAccount?
  products              PartnerProduct[]
  orders                PartnerOrder[]
  oauthStates           PartnerOAuthState[]

  @@map("partners")
  @@schema("public")
}

model PartnerPaymentAccount {
  partnerId            String   @id @map("partner_id") @db.Uuid
  providerUserId       String   @unique @map("provider_user_id")
  encryptedCredentials String   @map("encrypted_credentials")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  liveMode             Boolean  @map("live_mode")
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  partner              Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("partner_payment_accounts")
  @@schema("public")
}

model PartnerProduct {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  name         String
  description  String
  imageUrl     String   @map("image_url")
  priceCents   Int      @map("price_cents")
  stock        Int
  deliveryDays Int      @map("delivery_days")
  returnPolicy String   @map("return_policy")
  status       String   @default("PENDING_REVIEW")
  reviewNote   String?  @map("review_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders       PartnerOrder[]

  @@index([partnerId, createdAt(sort: Desc)], map: "partner_products_partner_idx")
  @@map("partner_products")
  @@schema("public")
}

model PartnerOrder {
  id                    String   @id @db.Uuid
  productId             String   @map("product_id") @db.Uuid
  partnerId             String   @map("partner_id") @db.Uuid
  productName           String   @map("product_name")
  totalCents            Int      @map("total_cents")
  commissionBps         Int      @map("commission_bps")
  commissionCents       Int      @map("commission_cents")
  buyer                 Json
  receiptToken          String   @default(dbgenerated("gen_random_uuid()")) @map("receipt_token") @db.Uuid
  status                String   @default("PENDING")
  fulfillmentStatus     String   @default("UNFULFILLED") @map("fulfillment_status")
  trackingCode          String?  @map("tracking_code")
  preferenceId          String?  @unique @map("preference_id")
  checkoutUrl           String?  @map("checkout_url")
  lastPaymentCheckAt    DateTime? @map("last_payment_check_at") @db.Timestamptz(6)
  stockReserved         Boolean  @default(true) @map("stock_reserved")
  paidCents             Int      @default(0) @map("paid_cents")
  refundedCents         Int      @default(0) @map("refunded_cents")
  earnedCommissionCents Int      @default(0) @map("earned_commission_cents")
  expiresAt             DateTime @default(dbgenerated("now() + interval '30 minutes'")) @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  partner               Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product               PartnerProduct @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments              PartnerPayment[]

  @@index([partnerId, createdAt(sort: Desc)], map: "partner_orders_partner_idx")
  @@index([status, expiresAt], map: "partner_orders_pending_idx")
  @@map("partner_orders")
  @@schema("public")
}

model PartnerPayment {
  providerPaymentId String   @id @map("provider_payment_id")
  orderId           String   @map("order_id") @db.Uuid
  status            String
  amountCents       Int      @map("amount_cents")
  refundedCents     Int      @map("refunded_cents")
  sourceUpdatedAt   DateTime @map("source_updated_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  order             PartnerOrder @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "partner_payments_order_idx")
  @@map("partner_payments")
  @@schema("public")
}

model PartnerOAuthState {
  stateHash String   @id @map("state_hash")
  partnerId String   @map("partner_id") @db.Uuid
  verifier  String
  expiresAt DateTime @default(dbgenerated("now() + interval '10 minutes'")) @map("expires_at") @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("partner_oauth_states")
  @@schema("public")
}

model PartnerRateLimit {
  key      String   @id
  attempts Int      @default(1)
  resetAt  DateTime @default(dbgenerated("now() + interval '15 minutes'")) @map("reset_at") @db.Timestamptz(6)

  @@map("partner_rate_limits")
  @@schema("public")
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas    = ["public"]
}

enum Role {
  USER
  ADMIN
  SUPERADMIN

  @@schema("public")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  PENDING_REVIEW

  @@schema("public")
}

enum CommissionStatus {
  PENDING
  APPROVED
  CANCELLED
  PAID

  @@schema("public")
}

model User {
  id            String      @id @default(uuid())
  name          String?
  email         String      @unique
  passwordHash  String?
  image         String?
  role          Role        @default(USER)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  favorites     Favorite[]
  clicks        Click[]
  auditLogs     AuditLog[]

  @@map("users")
  @@schema("public")
}

model AdminUser {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  auditLogs    AuditLog[]

  @@map("admin_users")
  @@schema("public")
}

model InstagramProfileCandidate {
  id         String   @id @default(uuid())
  username   String   @unique
  profileUrl String   @map("profile_url")
  notes      String?
  status     String   @default("PENDING_REVIEW")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("instagram_profile_candidates")
  @@schema("public")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?    @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
  @@schema("public")
}

model Supplier {
  id          String    @id @default(uuid())
  name        String
  website     String?
  contact     String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("suppliers")
  @@schema("public")
}

model Marketplace {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  logoUrl         String?            @map("logo_url")
  apiStatus       String             @default("ACTIVE") @map("api_status")
  affiliateStatus String             @default("ACTIVE") @map("affiliate_status")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  products        Product[]
  affiliateLinks  AffiliateLink[]
  conversions     Conversion[]
  affiliatePrograms AffiliateProgram[]

  @@map("marketplaces")
  @@schema("public")
}

model AffiliateProgram {
  id              String      @id @default(uuid())
  marketplaceId   String      @map("marketplace_id")
  name            String
  commissionRate  Decimal     @map("commission_rate") @db.Decimal(8, 4)
  cookieDuration  Int         @default(30) @map("cookie_duration") // dias
  termsUrl        String?     @map("terms_url")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  marketplace     Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@map("affiliate_programs")
  @@schema("public")
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  description          String
  categoryId           String        @map("category_id")
  supplierId           String?       @map("supplier_id")
  marketplaceId        String        @map("marketplace_id")
  productType          String?       @map("product_type")
  brand                String?
  imageUrl             String        @map("image_url")
  images               String        @default("[]") // JSON String array
  videoUrl             String?       @map("video_url")
  price                Decimal       @db.Decimal(14, 2)
  cost                 Decimal?      @db.Decimal(14, 2)
  platformFees         Decimal?      @map("platform_fees") @db.Decimal(14, 2)
  shippingCost         Decimal?      @map("shipping_cost") @db.Decimal(14, 2)
  marketingCost        Decimal?      @map("marketing_cost") @db.Decimal(14, 2)
  otherCosts           Decimal?      @map("other_costs") @db.Decimal(14, 2)
  oldPrice             Decimal?      @map("old_price") @db.Decimal(14, 2)
  discountPercentage   Float?        @map("discount_percentage")
  rating               Float         @default(0)
  reviewCount          Int           @default(0) @map("review_count")
  salesCount           Int           @default(0) @map("sales_count")
  popularityScore      Float         @default(0) @map("popularity_score")
  trendScore           Float         @default(0) @map("trend_score")
  commissionPercentage Decimal       @map("commission_percentage") @db.Decimal(8, 4)
  commissionValue      Decimal       @map("commission_value") @db.Decimal(14, 2)
  externalProductId    String        @map("external_product_id")
  originalUrl          String        @map("original_url")
  affiliateUrl         String        @map("affiliate_url")
  supplierInfo         String?       @map("supplier_info")
  targetAudience       String?       @map("target_audience")
  keyBenefits          String?       @map("key_benefits")
  keyObjections        String?       @map("key_objections")
  competitionNotes     String?       @map("competition_notes")
  deliveryTime         String?       @map("delivery_time")
  returnPolicy         String?       @map("return_policy")
  isBestSeller         Boolean       @default(false) @map("is_best_seller")
  isTrending           Boolean       @default(false) @map("is_trending")
  status               ProductStatus @default(ACTIVE)
  lastSyncedAt         DateTime      @default(now()) @map("last_synced_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  category             Category      @relation(fields: [categoryId], references: [id])
  supplier             Supplier?     @relation(fields: [supplierId], references: [id])
  marketplace          Marketplace   @relation(fields: [marketplaceId], references: [id])
  
  affiliateLinks       AffiliateLink[]
  clicks               Click[]
  conversions          Conversion[]
  favorites            Favorite[]
  metrics              ProductMetric?
  priceHistories       PriceHistory[]

  @@map("products")
  @@schema("public")
  @@unique([marketplaceId, externalProductId], map: "products_marketplace_external_unique")
}

model AffiliateLink {
  id            String      @id @default(uuid())
  productId     String      @map("product_id")
  marketplaceId String      @map("marketplace_id")
  url           String
  trackingId    String      @map("tracking_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  clicks        Click[]

  @@map("affiliate_links")
  @@schema("public")
}

model Click {
  id              String         @id @default(uuid())
  productId       String         @map("product_id")
  affiliateLinkId String?        @map("affiliate_link_id")
  sessionId       String?        @map("session_id")
  userId          String?        @map("user_id")
  utmSource       String?        @map("utm_source")
  utmMedium       String?        @map("utm_medium")
  utmCampaign     String?        @map("utm_campaign")
  device          String?
  ipHash          String?        @map("ip_hash")
  createdAt       DateTime       @default(now()) @map("created_at")

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  conversions     Conversion[]

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([sessionId])
  @@map("clicks")
  @@schema("public")
}

model Conversion {
  id               String       @id @default(uuid())
  clickId          String?      @map("click_id")
  productId        String       @map("product_id")
  marketplaceId    String       @map("marketplace_id")
  orderExternalId  String?      @map("order_external_id")
  saleValue        Decimal      @map("sale_value") @db.Decimal(14, 2)
  commissionValue  Decimal      @map("commission_value") @db.Decimal(14, 2)
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at")

  click            Click?       @relation(fields: [clickId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  marketplace      Marketplace  @relation(fields: [marketplaceId], references: [id])
  commission       Commission?

  @@unique([marketplaceId, orderExternalId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([clickId])
  @@map("conversions")
  @@schema("public")
}

model Commission {
  id              String           @id @default(uuid())
  conversionId    String           @unique @map("conversion_id")
  amount          Decimal          @db.Decimal(14, 2)
  status          CommissionStatus @default(PENDING)
  payoutDate      DateTime?        @map("payout_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  conversion      Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@map("commissions")
  @@schema("public")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
  @@schema("public")
}

model ProductMetric {
  id              String   @id @default(uuid())
  productId       String   @unique @map("product_id")
  totalClicks     Int      @default(0) @map("total_clicks")
  totalConversions Int     @default(0) @map("total_conversions")
  conversionRate  Float    @default(0) @map("conversion_rate")
  ctr             Float    @default(0)
  totalCommission Decimal  @default(0) @map("total_commission") @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_metrics")
  @@schema("public")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  price     Decimal  @db.Decimal(14, 2)
  oldPrice  Decimal? @map("old_price") @db.Decimal(14, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
  @@schema("public")
}

model AutomationRun {
  id          String   @id @default(uuid())
  workflow    String
  status      String
  summary     String?  @db.Text
  error       String?  @db.Text
  startedAt   DateTime @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationMs  Int?     @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workflow, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("automation_runs")
  @@schema("public")
}

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?    @map("admin_user_id")
  userId      String?    @map("user_id")
  action      String
  entity      String
  entityId    String?    @map("entity_id")
  details     String?
  createdAt   DateTime   @default(now()) @map("created_at")

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("public")
}
