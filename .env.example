# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/venda_sem_estoque?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Environment
NODE_ENV="development"

# Affiliate APIs
AMAZON_AFFILIATE_TAG="your-tag-20"
MERCADOLIVRE_CLIENT_ID="your-app-id"
MERCADOLIVRE_CLIENT_SECRET="your-app-secret"
SHOPEE_APP_KEY="your-shopee-key"
SHOPEE_APP_SECRET="your-shopee-secret"
ALIEXPRESS_APP_KEY="your-aliexpress-key"
ALIEXPRESS_APP_SECRET="your-aliexpress-secret"
