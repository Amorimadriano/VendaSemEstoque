# Database Configuration (Supabase PostgreSQL)
# DATABASE_URL: Transaction Pooler URL (Porta 6543 ou 5432 com pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Conexão direta com o banco para migrations e prisma db push (Porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Environment
NODE_ENV="development"

# Affiliate APIs
AMAZON_AFFILIATE_TAG="your-tag-20"
MERCADOLIVRE_CLIENT_ID="your-app-id"
MERCADOLIVRE_CLIENT_SECRET="your-app-secret"
MERCADOLIVRE_TOOL_ID="your-affiliate-tool-id"
MERCADOLIVRE_COMMISSION_PERCENTAGE="10"
PRODUCT_SEARCHES="eletronicos,celular,fones,notebook,smart tv,casa"
SHOPEE_APP_KEY="your-shopee-key"
SHOPEE_APP_SECRET="your-shopee-secret"
ALIEXPRESS_APP_KEY="your-aliexpress-key"
ALIEXPRESS_APP_SECRET="your-aliexpress-secret"
